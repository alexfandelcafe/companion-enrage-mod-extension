; Copy to scripts/EnRAGECompanionsExtension.ini or let the plugin create it.
MaxCompanions=3
; Existing enRAGE faction ID to assign to recruited NPCs. Default: Van der Linde (vdl).
; For a custom faction, use its exact ID from enRAGE's faction definition.
RecruitGangId=vdl
; For custom factions, set this to the same ID as RecruitGangId.
; vdl is special: it mirrors recruits into enRAGE's built-in Van der Linde StoryRoster.
; Other existing factions use the normal Roster list filtered by Gang ID.
RecruitRosterId=vdl
; True permits friendly fire; false blocks player targeting of recruited members.
AllowFriendlyFire=true
; Force the grey/disabled target dot even when friendly fire is enabled.
PreventTargeting=false
; Keep the native affinity meter in each recruited NPC's detail sheet.
; Greet/antagonize/physical-affinity adjustments are based on native game interactions.
EnableAffinity=true
AffinityTravelIntervalSeconds=300
AffinityTravelGain=1
AffinityCombatGain=2
AffinityTreatmentGain=3
; Injury detection and recovery countdown for active extension companions.
EnableInjurySystem=true
InjuryDamageThresholdPercent=10
InjuryRecoverySeconds=180
; Health percentage restored when an incapacitated recruit is helped up.
IncapacitatedHealthPercent=35
; Healing percentage and injury-recovery reduction provided by a paid treatment.
MedicineHealingPercent=100
MedicineRecoveryReductionSeconds=60
; Medicine price in cents; 100 = $1.00, 0 = free.
RecruitMedicineCostCents=100
